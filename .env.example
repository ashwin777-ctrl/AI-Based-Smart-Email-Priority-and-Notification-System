# ========================================================
# Database Configuration (Vercel Storage / Cloud)
# ========================================================

# 1. MongoDB (Vercel Storage -> MongoDB Atlas)
# Vercel automatically populates this when connecting MongoDB in Vercel Storage!
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/email_priority_system?retryWrites=true&w=majority

# 2. (Optional) PostgreSQL / Neon:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# 3. (Optional) Supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
